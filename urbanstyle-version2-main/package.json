    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
