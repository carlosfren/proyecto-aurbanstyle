    "karma-spec-reporter": "^0.0.36",
    "karma-webpack": "^5.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "webpack": "^5.97.0"
